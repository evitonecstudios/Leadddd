{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild src/api-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "node server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^4.0.0",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.2",
    "firebase": "^10.0.0",
    "firebase-admin": "^12.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^11.0.0",
    "papaparse": "^5.4.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "vite": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/express": "^4.17.21"
  }
}
